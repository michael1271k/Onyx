<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Onyx</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>app.onyx.health.michael.native</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>onyx</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSCameraUsageDescription</key>
	<string>Onyx uses the camera only to read a supplement's barcode so it can look the label up for you. No photo is taken or stored.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Onyx reads your activity, heart, sleep, body-measurement and nutrition data from Apple Health to work out your daily readiness and recovery scores, your training load and your energy balance, and to fill in the charts and Home Screen widgets. Nothing is read that you do not allow, and your data is stored only on this device and in your own private Onyx account.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Onyx saves the strength workouts you log — their duration and active energy — back to Apple Health, so the training you do here appears alongside the rest of your activity rings.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<false/>
	<key>ONYX_SUPABASE_ANON_KEY</key>
	<string>$(ONYX_SUPABASE_ANON_KEY)</string>
	<key>ONYX_SUPABASE_URL</key>
	<string>$(ONYX_SUPABASE_URL)</string>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
</dict>
</plist>
