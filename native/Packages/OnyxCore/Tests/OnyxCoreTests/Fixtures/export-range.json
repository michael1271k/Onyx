{
  "module": "reports/exportEnvelope",
  "fn": "ExportRange.span(today:weekStartDay:exportedThrough:)",
  "note": "W7. Hand-computed. `today` 2026-09-17 is a Thursday; 2026-09-22 is a Tuesday. `weekStartDay` 0 = Sunday, 1 = Monday, which is what `Week.startDay(fromEndDay:)` answers. `exportedThrough` is the END of the last span this device exported, so a span starts the day AFTER it. Both ends are clamped: a start after the end collapses onto the end (the second export in one day), and a span longer than `ExportRange.maxDays` (28) has its START pulled forward — never its end pushed back, because the end is always today and a document that stops before today would be silently stale. A device that has never exported reads `sinceLastExport` as this week, which is the same answer `thisWeek` gives.",
  "cases": [
    {
      "name": "this week so far, Sunday start, on a Thursday",
      "input": { "range": "thisWeek", "today": "2026-09-17", "weekStartDay": 0, "exportedThrough": null },
      "expected": { "start": "2026-09-13", "end": "2026-09-17", "days": 5 }
    },
    {
      "name": "this week so far, Monday start, on a Thursday",
      "input": { "range": "thisWeek", "today": "2026-09-17", "weekStartDay": 1, "exportedThrough": null },
      "expected": { "start": "2026-09-14", "end": "2026-09-17", "days": 4 }
    },
    {
      "name": "this week so far, on the week's own first day",
      "input": { "range": "thisWeek", "today": "2026-09-13", "weekStartDay": 0, "exportedThrough": null },
      "expected": { "start": "2026-09-13", "end": "2026-09-13", "days": 1 }
    },
    {
      "name": "last complete week, Sunday start",
      "input": { "range": "lastWeek", "today": "2026-09-17", "weekStartDay": 0, "exportedThrough": null },
      "expected": { "start": "2026-09-06", "end": "2026-09-12", "days": 7 }
    },
    {
      "name": "last complete week, Monday start",
      "input": { "range": "lastWeek", "today": "2026-09-17", "weekStartDay": 1, "exportedThrough": null },
      "expected": { "start": "2026-09-07", "end": "2026-09-13", "days": 7 }
    },
    {
      "name": "last seven days ignores the week boundary",
      "input": { "range": "last7Days", "today": "2026-09-17", "weekStartDay": 0, "exportedThrough": null },
      "expected": { "start": "2026-09-11", "end": "2026-09-17", "days": 7 }
    },
    {
      "name": "since last export — the day after the last span",
      "input": { "range": "sinceLastExport", "today": "2026-09-17", "weekStartDay": 0, "exportedThrough": "2026-09-12" },
      "expected": { "start": "2026-09-13", "end": "2026-09-17", "days": 5 }
    },
    {
      "name": "since last export — never exported falls back to this week",
      "input": { "range": "sinceLastExport", "today": "2026-09-17", "weekStartDay": 0, "exportedThrough": null },
      "expected": { "start": "2026-09-13", "end": "2026-09-17", "days": 5 }
    },
    {
      "name": "since last export — exported through today gives today again",
      "input": { "range": "sinceLastExport", "today": "2026-09-17", "weekStartDay": 0, "exportedThrough": "2026-09-17" },
      "expected": { "start": "2026-09-17", "end": "2026-09-17", "days": 1 }
    },
    {
      "name": "since last export — a marker in the future still gives today",
      "input": { "range": "sinceLastExport", "today": "2026-09-17", "weekStartDay": 0, "exportedThrough": "2026-09-30" },
      "expected": { "start": "2026-09-17", "end": "2026-09-17", "days": 1 }
    },
    {
      "name": "since last export — a long silence is capped at 28 days",
      "input": { "range": "sinceLastExport", "today": "2026-09-22", "weekStartDay": 0, "exportedThrough": "2026-03-01" },
      "expected": { "start": "2026-08-26", "end": "2026-09-22", "days": 28 }
    },
    {
      "name": "since last export — exactly 28 days is not clamped",
      "input": { "range": "sinceLastExport", "today": "2026-09-22", "weekStartDay": 0, "exportedThrough": "2026-08-25" },
      "expected": { "start": "2026-08-26", "end": "2026-09-22", "days": 28 }
    },
    {
      "name": "since last export — 29 days loses its oldest day",
      "input": { "range": "sinceLastExport", "today": "2026-09-22", "weekStartDay": 0, "exportedThrough": "2026-08-24" },
      "expected": { "start": "2026-08-26", "end": "2026-09-22", "days": 28 }
    },
    {
      "name": "since last export — across a year boundary",
      "input": { "range": "sinceLastExport", "today": "2027-01-03", "weekStartDay": 0, "exportedThrough": "2026-12-27" },
      "expected": { "start": "2026-12-28", "end": "2027-01-03", "days": 7 }
    },
    {
      "name": "last complete week across a year boundary",
      "input": { "range": "lastWeek", "today": "2027-01-03", "weekStartDay": 0, "exportedThrough": null },
      "expected": { "start": "2026-12-27", "end": "2027-01-02", "days": 7 }
    }
  ]
}
