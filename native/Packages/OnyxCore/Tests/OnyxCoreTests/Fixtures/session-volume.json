        "sets": [
          {
            "weightKg": 60,
            "reps": 12
          },
          {
            "weightKg": 60,
            "reps": 11
          },
          {
            "weightKg": 57.5,
            "reps": 10
          }
        ]
      },
      "expected": 1955
    },
    {
