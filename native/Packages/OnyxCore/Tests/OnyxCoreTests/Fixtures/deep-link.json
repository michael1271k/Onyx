{
  "module": "native/deepLink",
  "fn": "safePath / destination",
  "note": "The allow-list for onyx://open?path=… URLs: onyx scheme only, path must start with / and not //, query and fragment stripped before matching the clean path OR its first-segment root, the FULL path returned. `destination` is the native tab mapping (today · train · fuel · body(date) · you · reports); null path → null destination.",
  "cases": [
    {
      "name": "home",
      "input": {
        "raw": "onyx://open?path=/"
      },
      "expected": {
        "path": "/",
        "destination": {
          "kind": "today",
          "date": null
        }
      }
    },
    {
      "name": "nutrition",
      "input": {
        "raw": "onyx://open?path=/nutrition"
      },
      "expected": {
        "path": "/nutrition",
        "destination": {
          "kind": "fuel",
          "date": null
        }
      }
    },
    {
      "name": "nutrition micros — below an allowed root",
      "input": {
        "raw": "onyx://open?path=/nutrition/micros"
      },
      "expected": {
        "path": "/nutrition/micros",
        "destination": {
          "kind": "fuel",
          "date": null
        }
      }
    },
    {
      "name": "nutrition nutrients",
      "input": {
        "raw": "onyx://open?path=/nutrition/nutrients"
      },
      "expected": {
        "path": "/nutrition/nutrients",
        "destination": {
          "kind": "fuel",
          "date": null
        }
      }
    },
    {
      "name": "workout exercises",
      "input": {
        "raw": "onyx://open?path=/workout/exercises"
      },
      "expected": {
        "path": "/workout/exercises",
        "destination": {
          "kind": "train",
          "date": null
        }
      }
    },
    {
      "name": "session",
      "input": {
        "raw": "onyx://open?path=/session"
      },
      "expected": {
        "path": "/session",
        "destination": {
          "kind": "train",
          "date": null
        }
      }
    },
    {
      "name": "pathfinder",
      "input": {
        "raw": "onyx://open?path=/pathfinder"
      },
      "expected": {
        "path": "/pathfinder",
        "destination": {
          "kind": "body",
          "date": null
        }
      }
    },
    {
      "name": "reports",
      "input": {
        "raw": "onyx://open?path=/reports"
      },
      "expected": {
        "path": "/reports",
        "destination": {
          "kind": "reports",
          "date": null
        }
      }
    },
    {
      "name": "settings",
      "input": {
        "raw": "onyx://open?path=/settings"
      },
      "expected": {
        "path": "/settings",
        "destination": {
          "kind": "you",
          "date": null
        }
      }
    },
    {
      "name": "a day",
      "input": {
        "raw": "onyx://open?path=/day/2026-08-14"
      },
      "expected": {
        "path": "/day/2026-08-14",
        "destination": {
          "kind": "body",
          "date": "2026-08-14"
        }
      }
    },
    {
      "name": "a day with an unencoded query",
      "input": {
        "raw": "onyx://open?path=/day/2026-09-03?section=sleep"
      },
      "expected": {
        "path": "/day/2026-09-03?section=sleep",
        "destination": {
          "kind": "body",
          "date": "2026-09-03"
        }
      }
    },
    {
      "name": "a day with an encoded query",
      "input": {
        "raw": "onyx://open?path=%2Fday%2F2026-08-14%3Ftab%3Dsleep"
      },
      "expected": {
        "path": "/day/2026-08-14?tab=sleep",
        "destination": {
          "kind": "body",
          "date": "2026-08-14"
        }
      }
    },
    {
      "name": "a fragment is stripped before the check",
      "input": {
        "raw": "onyx://open?path=/nutrition%23macros"
      },
      "expected": {
        "path": "/nutrition#macros",
        "destination": {
          "kind": "fuel",
          "date": null
        }
      }
    },
    {
      "name": "upper-case scheme",
      "input": {
        "raw": "ONYX://open?path=/nutrition"
      },
      "expected": {
        "path": "/nutrition",
        "destination": {
          "kind": "fuel",
          "date": null
        }
      }
    },
    {
      "name": "a trailing slash",
      "input": {
        "raw": "onyx://open?path=/nutrition/"
      },
      "expected": {
        "path": "/nutrition/",
        "destination": {
          "kind": "fuel",
          "date": null
        }
      }
    },
    {
      "name": "dot-dot below an allowed root passes the allow-list (the TS does too)",
      "input": {
        "raw": "onyx://open?path=/nutrition/../admin"
      },
      "expected": {
        "path": "/nutrition/../admin",
        "destination": {
          "kind": "fuel",
          "date": null
        }
      }
    },
    {
      "name": "https scheme",
      "input": {
        "raw": "https://evil.example/nutrition"
      },
      "expected": {
        "path": null,
        "destination": null
      }
    },
    {
      "name": "javascript scheme",
      "input": {
        "raw": "javascript:alert(1)"
      },
      "expected": {
        "path": null,
        "destination": null
      }
    },
    {
      "name": "capacitor scheme",
      "input": {
        "raw": "capacitor://localhost/nutrition"
      },
      "expected": {
        "path": null,
        "destination": null
      }
    },
    {
      "name": "protocol-relative",
      "input": {
        "raw": "onyx://open?path=//evil.example"
      },
      "expected": {
        "path": null,
        "destination": null
      }
    },
    {
      "name": "protocol-relative below an allowed root",
      "input": {
        "raw": "onyx://open?path=//evil.example/nutrition"
      },
      "expected": {
        "path": null,
        "destination": null
      }
    },
    {
      "name": "absolute URL as the path",
      "input": {
        "raw": "onyx://open?path=https://evil.example/nutrition"
      },
      "expected": {
        "path": null,
        "destination": null
      }
    },
    {
      "name": "a route the app does not have",
      "input": {
        "raw": "onyx://open?path=/admin"
      },
      "expected": {
        "path": null,
        "destination": null
      }
    },
    {
      "name": "the old snapshot route",
      "input": {
        "raw": "onyx://open?path=/api/widget/snapshot"
      },
      "expected": {
        "path": null,
        "destination": null
      }
    },
    {
      "name": "case-sensitive",
      "input": {
        "raw": "onyx://open?path=/Nutrition"
      },
      "expected": {
        "path": null,
        "destination": null
      }
    },
    {
      "name": "relative path",
      "input": {
        "raw": "onyx://open?path=nutrition"
      },
      "expected": {
        "path": null,
        "destination": null
      }
    },
    {
      "name": "no path",
      "input": {
        "raw": "onyx://open"
      },
      "expected": {
        "path": null,
        "destination": null
      }
    },
    {
      "name": "empty string",
      "input": {
        "raw": ""
      },
      "expected": {
        "path": null,
        "destination": null
      }
    },
    {
      "name": "null",
      "input": {
        "raw": null
      },
      "expected": {
        "path": null,
        "destination": null
      }
    },
    {
      "name": "malformed",
      "input": {
        "raw": "onyx://%%%"
      },
      "expected": {
        "path": null,
        "destination": null
      }
    }
  ]
}
