# Onyx — environment for the service-role scripts under scripts/.
# Copy to .env.local and fill in. The app itself reads native/Onyx/Support/Secrets.xcconfig.
#
# The NEXT_PUBLIC_ prefix is historical (the web app named them); every script
# reads these exact names, so they stay.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
