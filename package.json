{
  "name": "helix-os",
  "version": "2.7.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check": "npm run version:check && npm run check:atlas && npm run check:mirror && npm run check:doms && next lint && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit",
    "check:swift": "bash scripts/check-swift.sh",
    "atlas": "node scripts/gen-atlas-swift.mjs",
    "check:atlas": "node scripts/gen-atlas-swift.mjs --check",
    "mirror": "node scripts/gen-mirror-swift.mjs",
    "check:mirror": "node scripts/gen-mirror-swift.mjs --check",
    "doms": "node scripts/gen-doms-swift.mjs",
    "check:doms": "node scripts/gen-doms-swift.mjs --check",
    "report:bundle": "node scripts/gen-report-bundle.mjs",
    "swift:core": "swift test --package-path native/Packages/OnyxCore --scratch-path \"$HOME/Library/Caches/onyx-swift/OnyxCore\"",
    "swift:data": "swift test --package-path native/Packages/OnyxData --scratch-path \"$HOME/Library/Caches/onyx-swift/OnyxData\"",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "native:gen": "npm run version:sync && cd native && xcodegen generate",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "icons": "node scripts/generate-icons.mjs",
    "analyze": "ANALYZE=true next build"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.1",
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/ios": "^6.2.1",
    "@capacitor/preferences": "^6.0.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@serwist/next": "^9.5.11",
    "@supabase/supabase-js": "^2.108.2",
    "@tanstack/query-sync-storage-persister": "^5.101.2",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-query-persist-client": "^5.101.2",
    "framer-motion": "^12.42.0",
    "lucide-react": "^1.21.0",
    "next": "15.5.25",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.9.0",
    "remark-gfm": "^4.0.1",
    "serwist": "^9.5.11",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "@eslint/eslintrc": "^3",
    "@netlify/plugin-nextjs": "^5.15.12",
    "@next/bundle-analyzer": "^16.3.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9",
    "eslint-config-next": "15.5.19",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "shadcn": "^4.11.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.1",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
