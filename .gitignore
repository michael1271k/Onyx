# Layout probes from e2e/set-row-grid.spec.ts — regenerated on every run, and a
# binary diff per run is noise. The FIXTURE beside them is not ignored: it is
# the spec's input, emitted by the unit suite.
/e2e/__screenshots__/

# iOS Widget/Watch secrets — the real xcconfig carries the snapshot token
ios/App/Secrets.xcconfig

# iOS snapshot secrets (token) — never commit
ios/App/App/Secrets.xcconfig

# graphify code-graph output (regenerated; ios/ copy is never wanted)
ios/App/graphify-out/

# graphify DATED SNAPSHOTS and CACHE — 99 MB of the repo's 108 MB, growing by
# ~5 MB a day. Every `graphify update .` writes a full dated copy of the graph
# beside the live one, and nothing reads them: `graphify query` and the CLAUDE.md
# workflow both read graphify-out/graph.json at the root, and the root manifest
# indexes source files, never a snapshot directory. The cache is a stat index
# that rebuilds itself on the next run, and its `last_query_stamp` changed on
# literally every command — noise in every `git status` and every diff.
#
# The nine live files at the root of graphify-out/ ARE still tracked, because
# the project's own instructions require graph.json to be present for queries.
graphify-out/20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
graphify-out/cache/

# Generated by @serwist/next from src/sw.ts on EVERY build (see next.config.ts
# swSrc/swDest). Tracking it meant every `npm run build` dirtied the worktree
# with a 49 KB artifact nobody edits, and it showed up in the diff of unrelated
# commits. The cap-sync copy under ios/App/App/public/ was already untracked.
public/sw.js

# native/ — the parallel SwiftUI app
#
# The Xcode project is GENERATED from native/project.yml by XcodeGen. Committing
# it would reintroduce exactly the hand-edited-pbxproj problem the generator
# exists to remove (a .swift file missing from a target fails at link time
# naming a symbol, not a file).
native/Onyx.xcodeproj/
native/*.xcworkspace/
.build/
# SwiftPM ALSO writes a plain `build/` beside `.build/` when a package is built
# through xcodebuild with an explicit `--triple`/`--sdk` — which is how the
# watchOS cross-build in `scripts/check-swift.sh` and the Wave 10 gate run it.
# Same artefact, different name, equally not ours to track.
native/Packages/*/build/
# And `xcodebuild`'s own, from building the OnyxWatch scheme on the command line.
native/build/
.swiftpm/
DerivedData/
# Supabase URL + anon key. See Secrets.example.xcconfig.
native/Onyx/Support/Secrets.xcconfig
# The graphify hook indexes any directory it is run in, including the Swift
# packages' checked-out dependencies. One graph, at the repo root.
native/**/graphify-out/

# Screenshots. Both kinds are regenerated from `OnyxSnapshot.sample` on
# demand — `scripts/native-shot.sh` for the visual QA loop, `store-shots.sh`
# for the App Store upload — and a phone screen is ~700 KB of PNG that
# changes on every layout edit. They are evidence for a review, not source.
native/__store__/
native/__screenshots__/

# agent tooling scratch (machine-local, not part of the app)
.agents/
.codex/
skills-lock.json

# graphify scratch (rebuild lock + pending queue, machine-local)
graphify-out/.rebuild.lock
graphify-out/.pending_changes
